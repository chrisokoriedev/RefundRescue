    {
      "name": "🔗 Webhooks",
      "item": [
        {
          "name": "Stripe Webhook — invoice.payment_failed",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "stripe-signature", "value": "t=123,v1=valid_signature" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"evt_test_payment_failed\",\n  \"type\": \"invoice.payment_failed\",\n  \"data\": {\n    \"object\": {\n      \"id\": \"inv_123\",\n      \"customer_name\": \"John Doe\",\n      \"customer_email\": \"john@acme.com\",\n      \"customer_phone\": \"+2349137891370\",\n      \"customer\": \"cus_123\",\n      \"amount_due\": 50000,\n      \"currency\": \"usd\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/stripe",
              "host": ["{{baseUrl}}"],
              "path": ["api", "webhooks", "stripe"]
            },
            "description": "Note: Requires valid Stripe webhook signature. Use Stripe CLI `stripe listen --forward-to localhost:3001/api/webhooks/stripe` to test locally."
          }
        },
        {
          "name": "Stripe Webhook — subscription.deleted",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "stripe-signature", "value": "t=123,v1=valid_signature" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"evt_test_sub_deleted\",\n  \"type\": \"customer.subscription.deleted\",\n  \"data\": {\n    \"object\": {\n      \"id\": \"sub_123\",\n      \"customer\": \"cus_123\",\n      \"items\": {\n        \"data\": [\n          {\n            \"plan\": {\n              \"amount\": 25000,\n              \"interval\": \"month\"\n            }\n          }\n        ]\n      }\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/stripe",
              "host": ["{{baseUrl}}"],
              "path": ["api", "webhooks", "stripe"]
            }
          }
        },
        {
          "name": "CALL-E Webhook — Call Completed",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"call_id\": \"run_123\",\n  \"status\": \"COMPLETED\",\n  \"duration_seconds\": 45,\n  \"summary\": \"Customer agreed to update their payment card.\",\n  \"transcript\": \"[00:00] BOT: Hello, is now a good moment?\\n[00:07] USER: Yeah, it's a good moment.\\n[00:09] BOT: Thank you, goodbye.\",\n  \"extracted_data\": {\n    \"outcome\": \"Saved\",\n    \"churn_reason\": \"Expired Card\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/calle",
              "host": ["{{baseUrl}}"],
              "path": ["api", "webhooks", "calle"]
            }
          }
        },
