# RevRescue Backend Configuration

# Server Port (5000 for Docker, 3001 for local dev)
PORT=3001

# Allowed CORS Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# AI Engine (optional — RevRescue automatically uses Heuristic Fallback if omitted)
# Get a free API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Error Monitoring (optional)
SENTRY_DSN=
