# ── Backend (optional) ──
# Google Gemini API key. If omitted, the backend runs in Heuristic Fallback mode
# with a clear banner notice — every feature still works end-to-end.
GEMINI_API_KEY=

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# ── Frontend (optional) ──
# Base URL of the backend API. In docker-compose this is preset to
# http://backend:5000; for local dev the default http://localhost:5000 is used.
# NEXT_PUBLIC_API_URL=http://localhost:5000
