# ==============================================================================
# RevRescue: AI-Powered Customer Support Refund System
# Environment Configuration
# ==============================================================================

# Backend Port (Default: 5000)
PORT=5000

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:5000

# Google Gemini API Key
# OPTIONAL: If left empty or omitted, RevRescue automatically operates in
# "Smart Heuristic Fallback" mode, providing realistic reasoning and empathetic
# customer drafting with zero configuration required.
GEMINI_API_KEY=your_gemini_api_key_here
